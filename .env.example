# ─── Twitch ─────────────────────────────────────────────────────────────────
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_OAUTH_TOKEN=oauth:your_twitch_oauth_token
TWITCH_BOT_NICK=your_bot_nickname
TWITCH_CHANNELS=channel1,channel2

# ─── Kick ────────────────────────────────────────────────────────────────────
KICK_CHANNELS=channel1,channel2

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# ─── AssemblyAI (optional, fallback to local Whisper) ────────────────────────
ASSEMBLYAI_API_KEY=your_assemblyai_api_key
USE_ASSEMBLYAI=false

# ─── Whisper ─────────────────────────────────────────────────────────────────
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu

# ─── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_CONCURRENCY=2

# ─── Storage ─────────────────────────────────────────────────────────────────
CLIPS_DIR=./data/clips
PROCESSED_DIR=./data/processed
RENDERS_DIR=./data/renders
COOKIES_DIR=./data/cookies

# ─── Pipeline thresholds ─────────────────────────────────────────────────────
CHAT_SPIKE_THRESHOLD=20
CHAT_WINDOW_SECONDS=10
CLIP_MIN_DURATION=20
CLIP_MAX_DURATION=60

# ─── Proxy (residential) ─────────────────────────────────────────────────────
PROXY_LIST=http://user:pass@proxy1:port,http://user:pass@proxy2:port

# ─── Publisher toggles ───────────────────────────────────────────────────────
PUBLISH_TIKTOK=true
PUBLISH_INSTAGRAM=true
PUBLISH_YOUTUBE=true

# ─── Monitoring ──────────────────────────────────────────────────────────────
PROMETHEUS_PORT=8000
